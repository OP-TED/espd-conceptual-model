{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OP-TED/espd-conceptual-model/enrichment/schema/parts-form.schema.json",
  "title": "Administrative part section form",
  "description": "parts/<part>/section<Letter>.form.json. How a section of an administrative part (I, II, VI) is filled in: its fields, their input types, labels and code lists. Field labels carry i18n keys plus the English text. The vocabulary (uiType, uiHints) is defined here and in registries/ui-hints.json, so every consumer reads the same one.",
  "type": "object",
  "required": ["part", "section", "title", "titleKey", "filledBy", "fields"],
  "properties": {
    "part": { "type": "string", "enum": ["I", "II", "VI"] },
    "section": { "type": "string", "pattern": "^[A-Z]$" },
    "title": { "type": "string", "minLength": 1 },
    "titleKey": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "descriptionKey": { "type": "string", "minLength": 1 },
    "filledBy": { "type": "string", "minLength": 1 },
    "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/field" } }
  },
  "dependencies": { "description": ["descriptionKey"], "descriptionKey": ["description"] },
  "patternProperties": { "^\\$": {} },
  "additionalProperties": false,
  "definitions": {
    "field": {
      "type": "object",
      "required": ["dataPath"],
      "properties": {
        "dataPath": { "type": "string", "pattern": "^part[IVX]+(\\.[A-Za-z][A-Za-z0-9]*(\\[\\])?)+$", "description": "A path into the instance data. [] marks an array whose items are filled in." },
        "kind": { "type": "string", "enum": ["caption"], "description": "A caption is a note with no data binding." },
        "labelKey": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "description": "English text for the catalogue." },
        "uiType": {
          "type": "string",
          "enum": ["text", "textarea", "url", "code", "lot-count", "lot-choice"],
          "description": "lot-count: a single integer the renderer expands into the partI.lots array (LOT-000n ids). lot-choice: a single select of the declared partI.lots (BR-LOT-10)."
        },
        "codelist": { "type": "string", "minLength": 1, "description": "A name or alias in registries/codelist-governance.json." },
        "required": { "type": "boolean" },
        "repeatable": { "type": "boolean" },
        "description": { "type": "string" },
        "visibleWhen": {
          "type": "object",
          "required": ["path", "isPresent"],
          "properties": { "path": { "type": "string", "minLength": 1 }, "isPresent": { "type": "boolean" } },
          "additionalProperties": false
        },
        "uiHints": {
          "type": "object",
          "properties": {
            "lookup": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "description": "A lookup in registries/ui-hints.json." },
                "inputKind": { "type": "string", "minLength": 1, "description": "One of that lookup's reads.inputKinds." }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "if": { "not": { "required": ["kind"], "properties": { "kind": { "const": "caption" } } } },
      "then": { "required": ["uiType", "labelKey", "label"], "properties": { "uiType": true, "labelKey": true, "label": true } },
      "additionalProperties": false,
      "patternProperties": { "^\\$": {} }
    }
  }
}
